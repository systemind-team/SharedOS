{
  "name": "@aicoo/sharedos-contracts",
  "version": "1.0.0-preview",
  "description": "JSON-safe protocol contracts for SharedOS",
  "license": "Apache-2.0",
  "keywords": [
    "agents",
    "authorization",
    "capabilities",
    "contracts",
    "runtime"
  ],
  "homepage": "https://www.aicoo.io",
  "bugs": {
    "email": "founders@aicoo.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemind-team/SharedOS.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!dist/**/*.test.*",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
